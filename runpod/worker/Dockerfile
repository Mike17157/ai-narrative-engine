# AUTO-GENERATED by gen_worker.py — do not hand-edit; re-run the generator.
# One image that runs ALL scanned workflows. Custom-node packs: Anima-LLLite, ComfyMath, ComfyUI-DCW, ComfyUI-RookieUI, ComfyUI-Spectrum-KSampler, Comfyroll-CustomNodes, Easy-Use, Image-Saver, Impact-Pack, KJNodes, Lora-Manager, Spectrum-SDXL, UltimateSDUpscale, rgthree-comfy, was-node-suite.
# Models are NOT baked in — they live on a RunPod network volume (see extra_model_paths.yaml).
ARG BASE_TAG=3.6.0-base
FROM timpietruskyblibla/runpod-worker-comfy:${BASE_TAG}

# Update ComfyUI to latest so newer samplers (er_sde, sa_solver, etc.) are available.
# The base image pins a release tag; fetch+checkout master gets us current HEAD.
RUN cd /comfyui && git fetch origin && git checkout origin/master && pip install --no-cache-dir -r requirements.txt

WORKDIR /comfyui/custom_nodes

# Each pack in its own RUN layer so Docker caches successful clones independently.
# Impact-Subpack MUST be a top-level sibling here (not nested inside ComfyUI-Impact-Pack/).
# ComfyUI only scans the top level of custom_nodes/; nesting it means UltralyticsDetectorProvider
# never registers → 400.
RUN git clone --depth 1 https://github.com/WASasquatch/was-node-suite-comfyui.git
RUN git clone --depth 1 https://github.com/Suzie1/ComfyUI_Comfyroll_CustomNodes.git
RUN git clone --depth 1 https://github.com/evanspearman/ComfyMath.git
RUN git clone --depth 1 https://github.com/kijai/ComfyUI-KJNodes.git
RUN git clone --depth 1 https://github.com/kohya-ss/ComfyUI-Anima-LLLite.git
RUN git clone --depth 1 https://github.com/ltdrdata/ComfyUI-Impact-Pack.git
RUN git clone --depth 1 https://github.com/alexopus/comfyui-image-saver.git
RUN git clone --depth 1 https://github.com/namemechan/ComfyUI-DCW.git
RUN git clone --depth 1 https://github.com/rgthree/rgthree-comfy.git
RUN git clone --depth 1 https://github.com/rookiestar28/ComfyUI-RookieUI.git
RUN git clone --depth 1 https://github.com/ruwwww/comfyui-spectrum-sdxl.git
RUN git clone --depth 1 https://github.com/sorryhyun/ComfyUI-Spectrum-KSampler.git
RUN git clone --depth 1 https://github.com/ssitu/ComfyUI_UltimateSDUpscale.git
RUN git clone --depth 1 https://github.com/willmiao/ComfyUI-Lora-Manager.git
RUN git clone --depth 1 https://github.com/yolain/ComfyUI-Easy-Use.git

# Install each pack's Python deps. Do NOT swallow failures (|| true) — a broken
# pip install leaves ComfyUI unable to load the pack → 400.
# Skip sam2 (heavy; not needed by the Anima FaceDetailer path which uses sam_vit_b).
# Replace opencv-python (needs GUI/GTK libs absent in this headless image) with the
# headless variant so cv2 and ultralytics import without libgthread errors.
RUN for d in */ ; do \
        if [ -f "$d/requirements.txt" ]; then \
            grep -viE '^(sam2|git\+https://github.com/facebookresearch/sam2)' "$d/requirements.txt" > /tmp/req.txt || true ; \
            if [ -s /tmp/req.txt ]; then pip install --no-cache-dir -r /tmp/req.txt ; fi ; \
        fi ; \
    done && \
    pip install --no-cache-dir "ultralytics>=8.0.0" "segment-anything" && \
    pip uninstall -y opencv-python opencv-python-headless && \
    pip install --no-cache-dir opencv-python-headless

# SageAttention: a faster fused-attention kernel the Anima model path patches in
# (KJNodes "PathchSageAttentionKJ", sage_attention=auto). The 1.0.6 PyPI wheel is
# pure-Triton — no nvcc/CUDA-toolkit build needed (triton ships in the base image).
# Without this the patch node raises ModuleNotFoundError → 400 whenever sage is on.
RUN pip install --no-cache-dir sageattention==1.0.6

# Placeholder for the workflow's hardcoded LoadImage reference (node "1744" → OIP.webp).
# ComfyUI validates EVERY node at submit time even when a switch bypasses it, so a
# missing input image 400s a txt2img render. A neutral 512² gray webp satisfies it.
RUN python3 -c "from PIL import Image; Image.new('RGB',(512,512),(128,128,128)).save('/comfyui/input/OIP.webp','WEBP')"

COPY extra_model_paths.yaml /comfyui/extra_model_paths.yaml
WORKDIR /
