# AUTO-GENERATED by gen_worker.py — do not hand-edit; re-run the generator.
# One image that runs ALL scanned workflows. Custom-node packs: Easy-Use, Impact-Pack, Impact-Subpack.
# Models are NOT baked in — they live on a RunPod network volume (see extra_model_paths.yaml).
ARG BASE_TAG=3.6.0-base
FROM timpietruskyblibla/runpod-worker-comfy:${BASE_TAG}

WORKDIR /comfyui/custom_nodes
RUN git clone --depth 1 https://github.com/ltdrdata/ComfyUI-Impact-Pack.git && \
    git clone --depth 1 https://github.com/ltdrdata/ComfyUI-Impact-Subpack.git && \
    git clone --depth 1 https://github.com/yolain/ComfyUI-Easy-Use.git

# Install each pack's Python deps. Do NOT swallow failures (|| true) — a broken
# pip install (e.g. sam2/transformers pulling an incompatible numpy/torch) leaves
# ComfyUI unable to load the pack, which makes /prompt reject every graph with a
# 400. Pin segment-anything and ultralytics explicitly; skip sam2 (heavy, and not
# needed by the Anima FaceDetailer path, which uses sam_vit_b).
RUN for d in */ ; do \
        if [ -f "$d/requirements.txt" ]; then \
            grep -viE '^(sam2|git\+https://github.com/facebookresearch/sam2)' "$d/requirements.txt" > /tmp/req.txt || true ; \
            if [ -s /tmp/req.txt ]; then pip install --no-cache-dir -r /tmp/req.txt ; fi ; \
        fi ; \
    done && \
    pip install --no-cache-dir "ultralytics>=8.0.0" "segment-anything"

COPY extra_model_paths.yaml /comfyui/extra_model_paths.yaml
WORKDIR /
