# AUTO-GENERATED by gen_worker.py — do not hand-edit; re-run the generator.
# One image that runs ALL scanned workflows. Custom-node packs: ComfyMath, DCW, Easy-Use, GGUF, Image-Saver, Impact-Pack, Impact-Subpack, KJNodes, Lora-Manager, Spectrum-KSampler, Spectrum-SDXL, UltimateSDUpscale, VideoHelperSuite, WanVideoWrapper, rgthree-comfy, was-node-suite.
# Models are NOT baked in — they live on a RunPod network volume (see extra_model_paths.yaml).
ARG BASE_TAG=3.6.0-base
FROM timpietruskyblibla/runpod-worker-comfy:${BASE_TAG}

# Update ComfyUI to latest so newer samplers (er_sde, sa_solver, etc.) are available.
# The base image pins a release tag; fetch+checkout master gets us current HEAD.
RUN cd /comfyui && git fetch origin && git checkout origin/master && pip install --no-cache-dir -r requirements.txt

# PyTorch >= 2.7.1. The base ships 2.6.0, but the Anima pipeline's KJNodes
# ModelPatchTorchSettings node probes torch.backends.cuda.matmul.allow_fp16_accumulation
# (added in 2.7.1) and RAISES on older torch — even with the setting disabled — killing every
# render. 2.7.x dropped cu124 wheels, so cu126 is the BAKED DEFAULT (covers Ampere/Ada/Hopper,
# sm_80–sm_90 — the serverless GPU pool). For other GPUs (e.g. Blackwell sm_120) the entrypoint
# adapts at runtime via light-the-torch (see adaptive_start.sh) — installed here, used only when
# the baked build can't run on the actual GPU.
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 torchaudio==2.7.1         --index-url https://download.pytorch.org/whl/cu126 &&     pip install --no-cache-dir light-the-torch

WORKDIR /comfyui/custom_nodes
# Impact-Subpack MUST be a top-level sibling here (not nested inside ComfyUI-Impact-Pack/).
# ComfyUI only scans the top level of custom_nodes/; nesting it means UltralyticsDetectorProvider
# never registers → 400.
RUN git clone --depth 1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git && \
    git clone --depth 1 https://github.com/WASasquatch/was-node-suite-comfyui.git && \
    git clone --depth 1 https://github.com/alexopus/comfyui-image-saver.git && \
    git clone --depth 1 https://github.com/city96/ComfyUI-GGUF.git && \
    git clone --depth 1 https://github.com/evanspearman/ComfyMath.git && \
    git clone --depth 1 https://github.com/kijai/ComfyUI-KJNodes.git && \
    git clone --depth 1 https://github.com/kijai/ComfyUI-WanVideoWrapper.git && \
    git clone --depth 1 https://github.com/ltdrdata/ComfyUI-Impact-Pack.git && \
    git clone --depth 1 https://github.com/ltdrdata/ComfyUI-Impact-Subpack.git && \
    git clone --depth 1 https://github.com/namemechan/ComfyUI-DCW.git && \
    git clone --depth 1 https://github.com/rgthree/rgthree-comfy.git && \
    git clone --depth 1 https://github.com/ruwwww/comfyui-spectrum-sdxl.git && \
    git clone --depth 1 https://github.com/sorryhyun/ComfyUI-Spectrum-KSampler.git && \
    git clone --depth 1 https://github.com/ssitu/ComfyUI_UltimateSDUpscale.git && \
    git clone --depth 1 https://github.com/willmiao/ComfyUI-Lora-Manager.git && \
    git clone --depth 1 https://github.com/yolain/ComfyUI-Easy-Use.git

# Install each pack's Python deps. Do NOT swallow failures (|| true) — a broken
# pip install leaves ComfyUI unable to load the pack → 400.
# Skip sam2 (heavy; not needed by the Anima FaceDetailer path which uses sam_vit_b).
# Replace opencv-python (needs GUI/GTK libs absent in this headless image) with the
# headless variant so cv2 and ultralytics import without libgthread errors.
RUN for d in */ ; do \
        if [ -f "$d/requirements.txt" ]; then \
            grep -viE '^(sam2|git\+https://github.com/facebookresearch/sam2)' "$d/requirements.txt" > /tmp/req.txt || true ; \
            if [ -s /tmp/req.txt ]; then pip install --no-cache-dir -r /tmp/req.txt ; fi ; \
        fi ; \
    done && \
    pip install --no-cache-dir "ultralytics>=8.0.0" "segment-anything" && \
    pip uninstall -y opencv-python opencv-python-headless && \
    pip install --no-cache-dir opencv-python-headless

# SageAttention: a faster fused-attention kernel the Anima model path patches in
# (KJNodes "PathchSageAttentionKJ", sage_attention=auto). The 1.0.6 PyPI wheel is
# pure-Triton — no nvcc/CUDA-toolkit build needed (triton ships in the base image).
# Without this the patch node raises ModuleNotFoundError → ComfyUI rejects the graph
# ("Error queuing workflow: HTTP 400") on every Anima render.
RUN pip install --no-cache-dir sageattention==1.0.6

# Placeholder LoadImage inputs (see scan): keep modern ComfyUI from 400-ing on a
# baked reference filename that isn't present in a fresh worker's empty input/ dir.
RUN python -c "from PIL import Image; from pathlib import Path; p=Path('/comfyui/input/OIP.webp'); p.parent.mkdir(parents=True, exist_ok=True); Image.new('RGB',(64,64)).save(p); p=Path('/comfyui/input/example.png'); p.parent.mkdir(parents=True, exist_ok=True); Image.new('RGB',(64,64)).save(p); p=Path('/comfyui/input/loom_init.png'); p.parent.mkdir(parents=True, exist_ok=True); Image.new('RGB',(64,64)).save(p)"

COPY extra_model_paths.yaml /comfyui/extra_model_paths.yaml

# Adapt PyTorch to the GPU the worker actually lands on (the baked build only covers
# sm_80–sm_90). adaptive_start.sh smoke-tests CUDA and, only if the baked torch can't run,
# reinstalls a matching build via light-the-torch, then hands off to the base /start.sh.
COPY adaptive_start.sh /adaptive_start.sh
RUN chmod +x /adaptive_start.sh
WORKDIR /
CMD ["/adaptive_start.sh"]
