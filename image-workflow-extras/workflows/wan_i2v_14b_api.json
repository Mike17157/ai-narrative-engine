{
  "1": {
    "class_type": "LoadImage",
    "_meta": { "title": "Start Image" },
    "inputs": { "image": "loom_init.png" }
  },
  "2": {
    "class_type": "ImageScale",
    "_meta": { "title": "Resize start" },
    "inputs": { "image": ["1", 0], "upscale_method": "lanczos", "width": 832, "height": 480, "crop": "center" }
  },
  "3": {
    "class_type": "WanVideoModelLoader",
    "_meta": { "title": "Wan HIGH expert" },
    "inputs": { "model": "DasiwaWAN22I2V14BLightspeed_snatchkissHighV11.safetensors", "base_precision": "fp16_fast", "quantization": "fp8_e4m3fn_scaled", "load_device": "offload_device", "attention_mode": "sdpa" }
  },
  "4": {
    "class_type": "WanVideoModelLoader",
    "_meta": { "title": "Wan LOW expert" },
    "inputs": { "model": "Wan2_2-I2V-A14B-LOW_fp8_e4m3fn_scaled_KJ.safetensors", "base_precision": "fp16_fast", "quantization": "fp8_e4m3fn_scaled", "load_device": "offload_device", "attention_mode": "sdpa" }
  },
  "5": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "_meta": { "title": "T5 Encoder" },
    "inputs": { "model_name": "umt5-xxl-enc-fp8_e4m3fn.safetensors", "precision": "bf16", "load_device": "offload_device", "quantization": "fp8_e4m3fn" }
  },
  "6": {
    "class_type": "WanVideoVAELoader",
    "_meta": { "title": "Wan VAE" },
    "inputs": { "model_name": "Wan2_1_VAE_bf16.safetensors", "precision": "bf16" }
  },
  "7": {
    "class_type": "WanVideoTextEncode",
    "_meta": { "title": "Prompt" },
    "inputs": { "positive_prompt": "cinematic motion, high quality", "negative_prompt": "blurry, low quality, distorted, static, watermark", "t5": ["5", 0], "force_offload": true, "device": "gpu" }
  },
  "8": {
    "class_type": "WanVideoImageToVideoEncode",
    "_meta": { "title": "I2V Encode" },
    "inputs": { "vae": ["6", 0], "start_image": ["2", 0], "width": 832, "height": 480, "num_frames": 81, "noise_aug_strength": 0.0, "start_latent_strength": 1.0, "end_latent_strength": 1.0, "force_offload": true }
  },
  "9": {
    "class_type": "WanVideoSampler",
    "_meta": { "title": "Sample (HIGH expert)" },
    "inputs": { "model": ["3", 0], "image_embeds": ["8", 0], "text_embeds": ["7", 0], "steps": 8, "cfg": 1.0, "shift": 8.0, "seed": 0, "force_offload": true, "scheduler": "unipc", "riflex_freq_index": 0, "start_step": 0, "end_step": 4 }
  },
  "10": {
    "class_type": "WanVideoSampler",
    "_meta": { "title": "Sample (LOW expert)" },
    "inputs": { "model": ["4", 0], "image_embeds": ["8", 0], "text_embeds": ["7", 0], "samples": ["9", 0], "steps": 8, "cfg": 1.0, "shift": 8.0, "seed": 0, "force_offload": true, "scheduler": "unipc", "riflex_freq_index": 0, "start_step": 4, "end_step": -1 }
  },
  "11": {
    "class_type": "WanVideoDecode",
    "_meta": { "title": "Decode" },
    "inputs": { "vae": ["6", 0], "samples": ["10", 0], "enable_vae_tiling": true, "tile_x": 272, "tile_y": 272, "tile_stride_x": 144, "tile_stride_y": 128 }
  },
  "12": {
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Combine → mp4" },
    "inputs": { "images": ["11", 0], "frame_rate": 16, "loop_count": 0, "filename_prefix": "wan_i2v", "format": "video/h264-mp4", "pix_fmt": "yuv420p", "crf": 19, "save_metadata": false, "trim_to_audio": false, "pingpong": false, "save_output": true }
  }
}
