{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Flux2 UNet" },
    "inputs": { "unet_name": "fluxdev/fluxKlein4BPro_v10.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoaderGGUF",
    "_meta": { "title": "Flux2 Text Encoder (GGUF)" },
    "inputs": { "clip_name": "Klein/flux2-klein-4b-uncensored-q8_0.gguf", "type": "flux2" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Flux2 VAE" },
    "inputs": { "vae_name": "flux2-vae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" },
    "inputs": { "text": "a photograph, natural light", "clip": ["2", 0] }
  },
  "5": {
    "class_type": "FluxGuidance",
    "_meta": { "title": "Flux Guidance" },
    "inputs": { "conditioning": ["4", 0], "guidance": 4.0 }
  },
  "6": {
    "class_type": "EmptyFlux2LatentImage",
    "_meta": { "title": "Empty Latent" },
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "7": {
    "class_type": "Flux2Scheduler",
    "_meta": { "title": "Flux2 Scheduler" },
    "inputs": { "steps": 20, "width": 1024, "height": 1024 }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "_meta": { "title": "Sampler" },
    "inputs": { "sampler_name": "euler" }
  },
  "9": {
    "class_type": "RandomNoise",
    "_meta": { "title": "Noise" },
    "inputs": { "noise_seed": 0 }
  },
  "10": {
    "class_type": "BasicGuider",
    "_meta": { "title": "Guider" },
    "inputs": { "model": ["1", 0], "conditioning": ["5", 0] }
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": { "title": "Sampler (Custom Advanced)" },
    "inputs": {
      "noise": ["9", 0],
      "guider": ["10", 0],
      "sampler": ["8", 0],
      "sigmas": ["7", 0],
      "latent_image": ["6", 0]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["11", 0], "vae": ["3", 0] }
  },
  "13": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "images": ["12", 0], "filename_prefix": "flux" }
  }
}
