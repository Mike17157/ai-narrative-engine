{
  "1": {
    "class_type": "WanVideoModelLoader",
    "_meta": { "title": "Wan Model" },
    "inputs": { "model": "Wan2_1-T2V-1_3B_bf16.safetensors", "base_precision": "bf16", "quantization": "disabled", "load_device": "offload_device", "attention_mode": "sdpa" }
  },
  "2": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "_meta": { "title": "Wan T5 Encoder" },
    "inputs": { "model_name": "umt5-xxl-enc-fp8_e4m3fn.safetensors", "precision": "bf16", "load_device": "offload_device", "quantization": "fp8_e4m3fn" }
  },
  "3": {
    "class_type": "WanVideoVAELoader",
    "_meta": { "title": "Wan VAE" },
    "inputs": { "model_name": "Wan2_1_VAE_bf16.safetensors", "precision": "bf16" }
  },
  "4": {
    "class_type": "WanVideoTextEncode",
    "_meta": { "title": "Positive Prompt" },
    "inputs": { "positive_prompt": "a photograph, natural light", "negative_prompt": "blurry, low quality, distorted, deformed", "t5": ["2", 0], "force_offload": true, "device": "gpu" }
  },
  "5": {
    "class_type": "WanVideoEmptyEmbeds",
    "_meta": { "title": "Empty Embeds (num_frames=1 → still; raise for video)" },
    "inputs": { "width": 512, "height": 512, "num_frames": 1 }
  },
  "6": {
    "class_type": "WanVideoSampler",
    "_meta": { "title": "Wan Sampler" },
    "inputs": { "model": ["1", 0], "image_embeds": ["5", 0], "text_embeds": ["4", 0], "steps": 20, "cfg": 6.0, "shift": 8.0, "seed": 7, "force_offload": true, "scheduler": "unipc", "riflex_freq_index": 0 }
  },
  "7": {
    "class_type": "WanVideoDecode",
    "_meta": { "title": "Wan Decode" },
    "inputs": { "vae": ["3", 0], "samples": ["6", 0], "enable_vae_tiling": true, "tile_x": 320, "tile_y": 320, "tile_stride_x": 192, "tile_stride_y": 192 }
  },
  "8": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "images": ["7", 0], "filename_prefix": "wan" }
  }
}
