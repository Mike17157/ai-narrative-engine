{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Krea2 Turbo (NVFP4)"
    },
    "inputs": {
      "unet_name": "krea2TurboOfficialComfy_krea2TurboNvfp4.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen3-VL text encoder (type=krea2)"
    },
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "krea2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Qwen-Image VAE"
    },
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "30": {
    "class_type": "easy loraStack",
    "_meta": {
      "title": "LoRA stack (configure up to 10)"
    },
    "inputs": {
      "toggle": false,
      "mode": "simple",
      "num_loras": 1,
      "lora_1_name": "None",
      "lora_1_strength": 1.0
    }
  },
  "31": {
    "class_type": "easy loraStackApply",
    "_meta": {
      "title": "Apply LoRA stack"
    },
    "inputs": {
      "lora_stack": [
        "30",
        0
      ],
      "model": [
        "1",
        0
      ],
      "optional_clip": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive prompt"
    },
    "inputs": {
      "text": "{{image}}",
      "clip": [
        "31",
        1
      ]
    }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Negative (zeroed \u00e2\u20ac\u201d Turbo runs CFG 1)"
    },
    "inputs": {
      "conditioning": [
        "4",
        0
      ]
    }
  },
  "5": {
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler (Krea2 Turbo: 8 steps, CFG 1, euler/simple)"
    },
    "inputs": {
      "model": [
        "31",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "7",
        0
      ],
      "latent_image": [
        "15",
        0
      ],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.6
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    },
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    },
    "inputs": {
      "images": [
        "12",
        0
      ],
      "filename_prefix": "krea2turbo"
    }
  },
  "14": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Init image"
    },
    "inputs": {
      "image": "example.png"
    }
  },
  "15": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode init -> latent"
    },
    "inputs": {
      "pixels": [
        "14",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "22": {
    "class_type": "easy imageRemBg",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "rem_mode": "Inspyrenet",
      "image_output": "Save",
      "save_prefix": "krea2turbo",
      "add_background": "none"
    },
    "_meta": {
      "title": "cutout (Inspyrenet)"
    }
  }
}