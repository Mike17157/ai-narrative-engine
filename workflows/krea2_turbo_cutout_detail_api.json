{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Krea2 Turbo (NVFP4)"
    },
    "inputs": {
      "unet_name": "krea2TurboOfficialComfy_krea2TurboNvfp4.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen3-VL text encoder (type=krea2)"
    },
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "krea2",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Qwen-Image VAE"
    },
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    }
  },
  "30": {
    "class_type": "easy loraStack",
    "_meta": {
      "title": "LoRA stack (configure up to 10)"
    },
    "inputs": {
      "toggle": false,
      "mode": "simple",
      "num_loras": 1,
      "lora_1_name": "None",
      "lora_1_strength": 1.0
    }
  },
  "31": {
    "class_type": "easy loraStackApply",
    "_meta": {
      "title": "Apply LoRA stack"
    },
    "inputs": {
      "lora_stack": [
        "30",
        0
      ],
      "model": [
        "1",
        0
      ],
      "optional_clip": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive prompt"
    },
    "inputs": {
      "text": "{{image}}",
      "clip": [
        "31",
        1
      ]
    }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Negative (zeroed \u00e2\u20ac\u201d Turbo runs CFG 1)"
    },
    "inputs": {
      "conditioning": [
        "4",
        0
      ]
    }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent"
    },
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    }
  },
  "5": {
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler (Krea2 Turbo: 8 steps, CFG 1, euler/simple)"
    },
    "inputs": {
      "model": [
        "31",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "7",
        0
      ],
      "latent_image": [
        "6",
        0
      ],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    },
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    },
    "inputs": {
      "images": [
        "12",
        0
      ],
      "filename_prefix": "krea2turbo"
    }
  },
  "22": {
    "class_type": "easy imageRemBg",
    "_meta": {
      "title": "Remove background -> transparent cutout"
    },
    "inputs": {
      "images": [
        "40",
        0
      ],
      "rem_mode": "Inspyrenet",
      "image_output": "Save",
      "save_prefix": "krea2turbo",
      "add_background": "none"
    }
  },
  "36": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": "bbox/face_yolov8m.pt"
    },
    "_meta": {
      "title": "face bbox"
    }
  },
  "37": {
    "class_type": "SAMLoader",
    "inputs": {
      "model_name": "sam_vit_b_01ec64.pth",
      "device_mode": "Prefer GPU"
    },
    "_meta": {
      "title": "SAM"
    }
  },
  "40": {
    "class_type": "FaceDetailer",
    "_meta": {
      "title": "FaceDetailer"
    },
    "inputs": {
      "image": [
        "12",
        0
      ],
      "model": [
        "31",
        0
      ],
      "clip": [
        "31",
        1
      ],
      "vae": [
        "3",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "7",
        0
      ],
      "bbox_detector": [
        "36",
        0
      ],
      "sam_model_opt": [
        "37",
        0
      ],
      "guide_size": 640,
      "guide_size_for": true,
      "max_size": 1024,
      "seed": 44,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.5,
      "feather": 12,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 3.0,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
