# Generated output
out/
datasets/
runpod_test_output/

# Editor / backup artifacts
*.bak

# Local model weights — large binaries. The manifest (models/manifest.yaml) is
# tracked; the actual weights are not. They live in ComfyUI's models folder.
models/**
!models/manifest.yaml
!models/**/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Local secrets / overrides
.env
secrets/

# Node / build artifacts
frontend/node_modules/
frontend/build/
.cache/
logs/

# Launcher exe (build artifact — rebuild with dotnet publish)
Loom.exe
Loom.dll
Loom.runtimeconfig.json

# Large data files (runtime-only, not source)
danbooru_character.csv
loom/data/

# Local model weights (GGUF) — large binaries, never tracked
*.gguf

# Runtime-generated state (not source): lorebook DB, wizard drafts, play sessions
configs/lorebooks.db
configs/sources.db
configs/genesis_runs/
configs/stories/drafts/
configs/story_sessions/

# Third-party trainer clone
trainer/

# Illustrious workflows — kept locally for reference but not tracked
workflows/illustrious_*.json
workflows/illustrious_*.json.*
