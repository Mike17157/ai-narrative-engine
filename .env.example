# Copy this file to ".env" and fill in your key. Loom loads it automatically.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Required when Loom is bound beyond localhost (for example: --host 0.0.0.0).
# Send it as: Authorization: Bearer <token>
# LOOM_API_TOKEN=replace-with-a-long-random-token

# Optional: require the token even when Loom is localhost-only.
# LOOM_REQUIRE_AUTH=true

# Optional: cap remote model downloads (bytes). Defaults to 20 GiB.
# LOOM_MAX_MODEL_DOWNLOAD_BYTES=21474836480
