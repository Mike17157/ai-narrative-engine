{
  "name": "loom-story-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "build:sidecar": "bun build --compile --target=bun-windows-x64-baseline --external mupdf src/main.ts --outfile dist/story-host.exe",
    "stage:tauri": "node scripts/stage-tauri-sidecar.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "15.10.5",
    "@oh-my-pi/pi-coding-agent": "15.10.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "bun": "1.3.14",
    "patch-package": "8.0.0",
    "typescript": "5.7.3"
  }
}
